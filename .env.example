# ==============================================================================
# Enterprise RAG & AI Observability Platform - Master Environment Variables
# ==============================================================================

# Supabase Postgres & Auth Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-supabase-service-role-key
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Cloudflare R2 / AWS S3 Object Storage
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-r2-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Vector Database (Pinecone)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=your-pinecone-index-name

# LLM & Embedding Model Providers
COHERE_API_KEY=your-cohere-api-key
COHERE_MODEL=embed-english-v3.0
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
JINA_API_KEY=your-jina-api-key
TAVILY_API_KEY=your-tavily-search-api-key

# Redis Broker & Cache Configuration
REDIS_URL=redis://localhost:6379/0

# FastAPI Service Communication & Security
FASTAPI_URL=http://127.0.0.1:8000
FASTAPI_SECRET_KEY=your-secure-fastapi-backend-secret-key

# Batching & Performance Tuning
BATCH_SIZE=100
TIME_SLEEP=8
